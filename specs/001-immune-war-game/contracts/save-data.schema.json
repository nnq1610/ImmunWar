{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immunwar.local/contracts/save-data.schema.json",
  "title": "Immune War Save Data",
  "$comment": "Contract for the current DTO after version-envelope parsing and migration. Runtime semantic validation additionally enforces catalog membership, map-order, completed subset, selected-map unlock, and primary/backup sequence rules; JsonUtility does not enforce this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "saveSequence",
    "savedAtUtc",
    "unlockedMapIds",
    "completedMapIds",
    "lastSelectedMapId",
    "musicVolume",
    "sfxVolume"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "saveSequence": {
      "type": "integer",
      "minimum": 0
    },
    "savedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "unlockedMapIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mapId"
      },
      "contains": {
        "const": "map_lung"
      }
    },
    "completedMapIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mapId"
      }
    },
    "lastSelectedMapId": {
      "$ref": "#/$defs/mapId"
    },
    "musicVolume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sfxVolume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "mapId": {
      "type": "string",
      "pattern": "^map_[a-z0-9_]+$"
    }
  }
}
